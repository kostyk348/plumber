[
  {
    "label": "plumb: отправить файл и строку",
    "command": "plumb send "$ZED_FILE:$ZED_ROW"",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "never"
  },
  {
    "label": "plumb: журнал (хвост)",
    "command": "plumb log -n 30",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  }
]
